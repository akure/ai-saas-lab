# config.env — layered config file (loaded before real environment variables,
# which always win if both are set). Dependency-free key=value format so this
# lab needs no YAML library.

HTTP_PORT=8080
LOG_LEVEL=info
DAILY_TOKEN_QUOTA=50
DATA_DIR=./data

# --- Metering Storage Configuration ---
# Multi-backend metering chain. Comma-separated list of backends.
# Available: memory, postgres, redis
# Default: memory (in-memory only, always present as L1)
# METERING_BACKENDS=memory

# PostgreSQL persistent backend (L3) — uncomment to enable
# METERING_POSTGRES_DSN=postgres://user:pass@localhost:5432/metering?sslmode=disable

# Redis cache backend (L2) — uncomment to enable
# METERING_REDIS_ADDR=localhost:6379

# Write-Ahead Log for transient failure recovery
# METERING_WAL_ENABLED=true
# METERING_WAL_DIR=./data/wal
# METERING_WAL_RETRY_MS=5000

# Circuit breaker (per-backend failure protection)
# METERING_CB_THRESHOLD=5
# METERING_CB_COOLDOWN_MS=30000

# Async write channel capacity (backpressure threshold)
# METERING_CHANNEL_SIZE=10000

# Event deduplication retention window (milliseconds)
# METERING_DEDUP_RETENTION_MS=3600000

# Batch writer for slow backends
# METERING_BATCH_SIZE=100
# METERING_BATCH_FLUSH_MS=1000

# --- Catalog Storage Configuration ---
# Controls the TenantCatalogStore chain (service/metric/plan registration persistence).
# Multi-backend chain. Comma-separated list: memory, redis, postgres
# L1=memory is always guaranteed (auto-prepended if omitted).
# Default: memory (in-process, no external deps required)
# CATALOG_BACKENDS=memory

# PostgreSQL persistent backend (L3) for catalog — source of truth.
# Falls back to METERING_POSTGRES_DSN if not set separately.
# CATALOG_POSTGRES_DSN=postgres://user:pass@localhost:5432/aisaas?sslmode=disable

# Redis distributed cache (L2) for catalog — TTL-based, 24h default.
# Falls back to METERING_REDIS_ADDR if not set separately.
# CATALOG_REDIS_ADDR=localhost:6379

# TTL for catalog entries in Redis (hours). Entries auto-expire if tenant is deleted.
# Default: 24
# CATALOG_REDIS_TTL_HOURS=24

# Dedicated CatalogWAL for write-failure recovery (separate from metering WAL).
# Segments stored in CATALOG_WAL_DIR; replay retried every 5 seconds.
# CATALOG_WAL_ENABLED=true
# CATALOG_WAL_DIR=./data/wal/catalog

# Example: full stack catalog (uncomment all three backends + WAL)
# CATALOG_BACKENDS=memory,redis,postgres
# CATALOG_REDIS_ADDR=localhost:6379
# CATALOG_POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/aisaas?sslmode=disable
# CATALOG_WAL_ENABLED=true
